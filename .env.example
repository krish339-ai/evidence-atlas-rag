# Default: local excerpt-only mode. No credentials or external calls.
EVIDENCE_ATLAS_MODE=demo
# Set mode to live to enable semantic embeddings and generated answers.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Embeddings can use a separate compatible provider.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
# Optional existing Pinecone dense index. No index is created or modified by setup.
# Pinecone requires EVIDENCE_ATLAS_MODE=live and the matching model credentials above.
VECTOR_BACKEND=memory
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# A random collection suffix is always added; the default namespace is never used.
PINECONE_NAMESPACE_PREFIX=evidence-atlas
# No provider is contacted in demo mode. Never commit your .env.
